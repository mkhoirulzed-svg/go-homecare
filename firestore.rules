rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == 'Vsl0uEluR5TCOdqVY7UPX2wfw6y1';
    }

    function isVerifiedPractitioner(uid) {
      return uid is string
        && userDocExists(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'praktisi'
        && get(/databases/$(database)/documents/users/$(uid)).data.isVerified == true;
    }

    function isCompletePatient() {
      return signedIn()
        && userDocExists(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pasien'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileComplete == true;
    }

    // Chat tindak lanjut hanya untuk pasien pemilik pesanan dan praktisi yang ditugaskan.
    function chatBookingExists(bookingId) {
      return exists(/databases/$(database)/documents/bookingRequests/$(bookingId));
    }
    function isChatParticipant(bookingId) {
      return signedIn() && chatBookingExists(bookingId)
        && (
          get(/databases/$(database)/documents/bookingRequests/$(bookingId)).data.patientUid == request.auth.uid
          || get(/databases/$(database)/documents/bookingRequests/$(bookingId)).data.nurseUid == request.auth.uid
        );
    }
    function isChatReadable(bookingId) {
      return chatBookingExists(bookingId)
        && get(/databases/$(database)/documents/bookingRequests/$(bookingId)).data.status
          in ['accepted', 'in_progress', 'completed'];
    }
    function isChatOpen(bookingId) {
      return chatBookingExists(bookingId)
        && get(/databases/$(database)/documents/bookingRequests/$(bookingId)).data.status
          in ['accepted', 'in_progress', 'completed']
        && get(/databases/$(database)/documents/bookingRequests/$(bookingId)).data.nurseUid is string;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.profileComplete == false
        && (
          (request.resource.data.role == 'pasien'
            && !request.resource.data.keys().hasAny(['isVerified']))
          ||
          (request.resource.data.role == 'praktisi'
            && request.resource.data.isVerified == false)
        )
        && request.resource.data.keys().hasOnly([
          'uid', 'nama', 'email', 'foto', 'role', 'profileComplete', 'updatedAt', 'isVerified'
        ]);

      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Admin can approve/reject a practitioner; ordinary users cannot change role or verification.
      allow update: if isAdmin()
        || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nama', 'phone', 'profileComplete', 'updatedAt',
          'birthDate', 'gender', 'address', 'emergencyContact',
          'strNumber', 'experience', 'specialization', 'bio', 'tarif', 'serviceArea'
        ]));
      allow delete: if false;
    }

    // Katalog layanan baku dikelola admin dan dapat dibaca pengguna yang login.
    match /serviceCatalog/{catalogId} {
      function validCatalogFields() {
        return request.resource.data.keys().hasAll(['name', 'description', 'active', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['name', 'description', 'active', 'createdAt', 'updatedAt', 'createdBy'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 300
          && request.resource.data.active is bool;
      }

      allow get, list: if signedIn();
      allow create: if isAdmin()
        && validCatalogFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && validCatalogFields()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Lokasi praktisi: aturan aditif untuk fondasi multi-lokasi.
    // Dokumen lokasi tidak menyimpan data pasien atau nomor telepon pribadi.
    match /practitionerLocations/{locationId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (
          isCompletePatient()
          && resource.data.status == 'published'
        );

      allow create: if signedIn()
        && isVerifiedPractitioner(request.auth.uid)
        && request.resource.data.keys().hasAll([
          'ownerUid', 'name', 'locationType', 'address', 'area',
          'city', 'province', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'locationType', 'address', 'area',
          'kelurahan', 'areaScope', 'areas', 'city', 'province', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.locationType in ['practice', 'home_visit']
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && (request.resource.data.locationType == 'home_visit'
          || request.resource.data.address.size() > 0)
        && request.resource.data.area is string
        && request.resource.data.area.size() > 0
        && request.resource.data.area.size() <= 200
        && (!request.resource.data.keys().hasAny(['areaScope'])
          || request.resource.data.areaScope in ['district', 'citywide'])
        && (!request.resource.data.keys().hasAny(['areas'])
          || (request.resource.data.areas is list
            && request.resource.data.areas.size() >= 1
            && request.resource.data.areas.size() <= 5))
        && (!request.resource.data.keys().hasAny(['kelurahan'])
          || (request.resource.data.kelurahan is string
            && request.resource.data.kelurahan.size() > 0
            && request.resource.data.kelurahan.size() <= 100))
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 100
        && request.resource.data.province is string
        && request.resource.data.province.size() > 0
        && request.resource.data.province.size() <= 100
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Praktisi hanya dapat mengubah lokasi miliknya yang belum dipublikasikan.
      // Mengajukan tinjauan dilakukan dengan status pending_review.
      allow update: if (
        signedIn()
        && isVerifiedPractitioner(request.auth.uid)
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status in ['draft', 'rejected']
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status in ['draft', 'pending_review']
        && request.resource.data.keys().hasAll([
          'ownerUid', 'name', 'locationType', 'address', 'area',
          'city', 'province', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'locationType', 'address', 'area',
          'kelurahan', 'areaScope', 'areas', 'city', 'province', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.locationType in ['practice', 'home_visit']
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && (request.resource.data.locationType == 'home_visit'
          || request.resource.data.address.size() > 0)
        && request.resource.data.area is string
        && request.resource.data.area.size() > 0
        && request.resource.data.area.size() <= 200
        && (!request.resource.data.keys().hasAny(['areaScope'])
          || request.resource.data.areaScope in ['district', 'citywide'])
        && (!request.resource.data.keys().hasAny(['areas'])
          || (request.resource.data.areas is list
            && request.resource.data.areas.size() >= 1
            && request.resource.data.areas.size() <= 5))
        && (!request.resource.data.keys().hasAny(['kelurahan'])
          || (request.resource.data.kelurahan is string
            && request.resource.data.kelurahan.size() > 0
            && request.resource.data.kelurahan.size() <= 100))
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 100
        && request.resource.data.province is string
        && request.resource.data.province.size() > 0
        && request.resource.data.province.size() <= 100
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
      ) || (
        isAdmin()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ])
        && (
          (resource.data.status == 'pending_review'
            && request.resource.data.status in ['published', 'rejected'])
          || (resource.data.status == 'published'
            && request.resource.data.status == 'paused')
          || (resource.data.status == 'paused'
            && request.resource.data.status == 'published'
            && isVerifiedPractitioner(resource.data.ownerUid))
        )
        && (request.resource.data.status != 'published'
          || isVerifiedPractitioner(resource.data.ownerUid))
        && request.resource.data.updatedAt == request.time
      );

      allow delete: if false;
    }


    // Jadwal mingguan per lokasi.
    match /practitionerLocations/{locationId}/weeklySchedule/{scheduleId} {
      function parentLocationExists() {
        return exists(/databases/$(database)/documents/practitionerLocations/$(locationId));
      }
      function parentLocation() {
        return get(/databases/$(database)/documents/practitionerLocations/$(locationId)).data;
      }
      function validScheduleFields() {
        return request.resource.data.keys().hasAll(['dayOfWeek', 'startTime', 'endTime', 'active', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['dayOfWeek', 'startTime', 'endTime', 'active', 'createdAt', 'updatedAt'])
          && request.resource.data.dayOfWeek is int
          && request.resource.data.dayOfWeek >= 0
          && request.resource.data.dayOfWeek <= 6
          && request.resource.data.startTime is string
          && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.endTime is string
          && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.startTime < request.resource.data.endTime
          && request.resource.data.active is bool;
      }

      allow get, list: if isAdmin()
        || (signedIn() && parentLocationExists() && parentLocation().ownerUid == request.auth.uid)
        || (isCompletePatient() && parentLocationExists()
          && parentLocation().status == 'published' && resource.data.active == true);

      allow create: if signedIn()
        && isVerifiedPractitioner(request.auth.uid)
        && parentLocationExists()
        && parentLocation().ownerUid == request.auth.uid
        && parentLocation().status in ['draft', 'published']
        && validScheduleFields()
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && isVerifiedPractitioner(request.auth.uid)
        && parentLocationExists()
        && parentLocation().ownerUid == request.auth.uid
        && parentLocation().status in ['draft', 'published']
        && validScheduleFields()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dayOfWeek', 'startTime', 'endTime', 'active', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // Katalog layanan dan tarif terikat pada lokasi induk.
    match /practitionerLocations/{locationId}/services/{serviceId} {
      function parentLocationExists() {
        return exists(/databases/$(database)/documents/practitionerLocations/$(locationId));
      }
      function parentLocation() {
        return get(/databases/$(database)/documents/practitionerLocations/$(locationId)).data;
      }
      function validServiceFields() {
        return request.resource.data.keys().hasAll([
          'name', 'description', 'price', 'durationMinutes',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'price', 'durationMinutes',
          'status', 'createdAt', 'updatedAt', 'reviewedBy', 'reviewedAt', 'reviewNote', 'catalogId', 'isCustom'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000000
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 5
        && request.resource.data.durationMinutes <= 1440
        && (!request.resource.data.keys().hasAny(['catalogId']) || request.resource.data.catalogId is string)
        && (!request.resource.data.keys().hasAny(['isCustom']) || request.resource.data.isCustom is bool);
      }

      allow get, list: if isAdmin()
        || (
          signedIn()
          && parentLocationExists()
          && parentLocation().ownerUid == request.auth.uid
        )
        || (
          isCompletePatient()
          && parentLocationExists()
          && parentLocation().status == 'published'
          && resource.data.status == 'published'
        );

      allow create: if signedIn()
        && isVerifiedPractitioner(request.auth.uid)
        && parentLocationExists()
        && parentLocation().ownerUid == request.auth.uid
        && parentLocation().status in ['draft', 'published']
        && validServiceFields()
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'reviewNote']);

      allow update: if (
        signedIn()
        && isVerifiedPractitioner(request.auth.uid)
        && parentLocationExists()
        && parentLocation().ownerUid == request.auth.uid
        && parentLocation().status in ['draft', 'published']
        && resource.data.status in ['draft', 'rejected']
        && request.resource.data.status in ['draft', 'pending_review']
        && validServiceFields()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'price', 'durationMinutes', 'status', 'updatedAt', 'catalogId', 'isCustom'
        ])
      ) || (
        isAdmin()
        && parentLocationExists()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'reviewNote', 'updatedAt'
        ])
        && (
          (resource.data.status == 'pending_review'
            && request.resource.data.status in ['published', 'rejected'])
          || (resource.data.status == 'published'
            && request.resource.data.status == 'paused')
          || (resource.data.status == 'paused'
            && request.resource.data.status == 'published')
        )
        && (request.resource.data.status != 'published'
          || (
            parentLocation().status == 'published'
            && isVerifiedPractitioner(parentLocation().ownerUid)
          ))
        && request.resource.data.updatedAt == request.time
      );

      allow delete: if false;
    }

    match /practitionerApplications/{applicationId} {
      allow create: if signedIn()
        && applicationId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pasien'
          ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'praktisi'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == false
          )
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','nama','email','phone','strNumber','experience','specialization','bio','tarif','status','createdAt','updatedAt']);
      allow get: if signedIn() && (isAdmin() || applicationId == request.auth.uid);
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','updatedAt'])
        && request.resource.data.status in ['approved','rejected'];
      allow delete: if false;
    }

    match /bookingRequests/{requestId} {
      // Pilihan katalog divalidasi terhadap dokumen lokasi/layanan yang masih terpublikasi.
      function validCatalogBooking() {
        return request.resource.data.keys().hasAll([
          'locationId', 'serviceId', 'locationName', 'locationType',
          'servicePrice', 'serviceDurationMinutes', 'practitionerUid'
        ])
        && request.resource.data.locationId is string
        && request.resource.data.locationId.size() > 0
        && request.resource.data.serviceId is string
        && request.resource.data.serviceId.size() > 0
        && request.resource.data.locationName is string
        && request.resource.data.locationName.size() > 0
        && request.resource.data.locationName.size() <= 120
        && request.resource.data.locationType in ['practice', 'home_visit']
        && request.resource.data.servicePrice is int
        && request.resource.data.servicePrice >= 0
        && request.resource.data.servicePrice <= 100000000
        && request.resource.data.serviceDurationMinutes is int
        && request.resource.data.serviceDurationMinutes >= 5
        && request.resource.data.serviceDurationMinutes <= 1440
        && request.resource.data.practitionerUid is string
        && request.resource.data.serviceName is string
        && exists(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId))
        && exists(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)/services/$(request.resource.data.serviceId))
        && get(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)).data.status == 'published'
        && get(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)).data.ownerUid == request.resource.data.practitionerUid
        && get(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)).data.name == request.resource.data.locationName
        && get(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)).data.locationType == request.resource.data.locationType
        && isVerifiedPractitioner(request.resource.data.practitionerUid)
        && get(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)/services/$(request.resource.data.serviceId)).data.status == 'published'
        && get(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)/services/$(request.resource.data.serviceId)).data.name == request.resource.data.serviceName
        && get(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)/services/$(request.resource.data.serviceId)).data.price == request.resource.data.servicePrice
        && get(/databases/$(database)/documents/practitionerLocations/$(request.resource.data.locationId)/services/$(request.resource.data.serviceId)).data.durationMinutes == request.resource.data.serviceDurationMinutes;
      }

      allow get, list: if signedIn()
        && (
          isAdmin()
          || resource.data.patientUid == request.auth.uid
          || resource.data.nurseUid == request.auth.uid
        );

      allow create: if isCompletePatient()
        && request.resource.data.keys().hasAll([
          'patientUid', 'bookerUid', 'bookerName', 'bookingFor', 'relationship',
          'patientName', 'patientPhone', 'patientAddress',
          'serviceName', 'scheduledAt', 'area', 'notes',
          'nurseUid', 'nurseName', 'nursePhone', 'status',
          'bookingSource', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'patientUid', 'bookerUid', 'bookerName', 'bookingFor', 'relationship',
          'patientName', 'patientPhone', 'patientAddress',
          'serviceName', 'scheduledAt', 'area', 'notes',
          'nurseUid', 'nurseName', 'nursePhone', 'status',
          'bookingSource', 'createdAt', 'updatedAt',
          'locationId', 'serviceId', 'locationName', 'locationType',
          'servicePrice', 'serviceDurationMinutes', 'practitionerUid'
        ])
        && request.resource.data.patientUid == request.auth.uid
        && request.resource.data.bookerUid == request.auth.uid
        && request.resource.data.bookerName is string
        && request.resource.data.bookerName.size() > 0
        && request.resource.data.bookingFor in ['self', 'family']
        && request.resource.data.relationship is string
        && request.resource.data.relationship.size() > 0
        && (request.resource.data.bookingFor == 'family'
          || request.resource.data.relationship == 'Diri sendiri')
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0
        && request.resource.data.patientPhone is string
        && request.resource.data.patientAddress is string
        && request.resource.data.patientAddress.size() > 0
        && (
          (
            request.resource.data.keys().hasAny([
              'locationId', 'serviceId', 'locationName', 'locationType',
              'servicePrice', 'serviceDurationMinutes', 'practitionerUid'
            ])
            && validCatalogBooking()
          )
          || (
            !request.resource.data.keys().hasAny([
              'locationId', 'serviceId', 'locationName', 'locationType',
              'servicePrice', 'serviceDurationMinutes', 'practitionerUid'
            ])
            && request.resource.data.serviceName in [
              'Perawatan Luka',
              'Perawatan Luka Diabetes / Dekubitus',
              'Perawatan Luka Operasi',
              'Pemasangan Infus',
              'Pemberian Injeksi',
              'Injeksi Vitamin',
              'Perawatan Kateter',
              'Perawatan NGT',
              'Perawatan Kolostomi',
              'Perawatan Lansia (Harian)',
              'Sunat'
            ]
          )
        )
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.area is string
        && request.resource.data.area.size() > 0
        && request.resource.data.notes is string
        && request.resource.data.nurseUid == null
        && request.resource.data.nurseName == null
        && request.resource.data.nursePhone == null
        && request.resource.data.status == 'pending'
        && request.resource.data.bookingSource == 'github-pages'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Pemilik hanya dapat mengedit rincian formulir ketika pesanan masih pending.
      allow update: if (
        isCompletePatient()
        && resource.data.patientUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.patientUid == resource.data.patientUid
        && request.resource.data.bookerUid == resource.data.bookerUid
        && request.resource.data.bookerName == resource.data.bookerName
        && request.resource.data.nurseUid == resource.data.nurseUid
        && request.resource.data.nurseName == resource.data.nurseName
        && request.resource.data.nursePhone == resource.data.nursePhone
        && request.resource.data.bookingSource == resource.data.bookingSource
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'patientUid', 'bookerUid', 'bookerName', 'bookingFor', 'relationship',
          'patientName', 'patientPhone', 'patientAddress',
          'serviceName', 'scheduledAt', 'area', 'notes',
          'nurseUid', 'nurseName', 'nursePhone', 'status',
          'bookingSource', 'createdAt', 'updatedAt',
          'locationId', 'serviceId', 'locationName', 'locationType',
          'servicePrice', 'serviceDurationMinutes', 'practitionerUid'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'bookingFor', 'relationship', 'patientName', 'patientPhone',
          'patientAddress', 'serviceName', 'scheduledAt', 'area', 'notes', 'updatedAt'
        ])
        && request.resource.data.bookingFor in ['self', 'family']
        && request.resource.data.relationship is string
        && request.resource.data.relationship.size() > 0
        && (request.resource.data.bookingFor == 'family'
          || request.resource.data.relationship == 'Diri sendiri')
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0
        && request.resource.data.patientPhone is string
        && request.resource.data.patientAddress is string
        && request.resource.data.patientAddress.size() > 0
        && (
          (
            resource.data.keys().hasAny(['locationId'])
            && request.resource.data.serviceName == resource.data.serviceName
            && request.resource.data.locationId == resource.data.locationId
            && request.resource.data.serviceId == resource.data.serviceId
            && request.resource.data.locationName == resource.data.locationName
            && request.resource.data.locationType == resource.data.locationType
            && request.resource.data.servicePrice == resource.data.servicePrice
            && request.resource.data.serviceDurationMinutes == resource.data.serviceDurationMinutes
            && request.resource.data.practitionerUid == resource.data.practitionerUid
          )
          || (
            !resource.data.keys().hasAny(['locationId'])
            && request.resource.data.serviceName in [
              'Perawatan Luka',
              'Perawatan Luka Diabetes / Dekubitus',
              'Perawatan Luka Operasi',
              'Pemasangan Infus',
              'Pemberian Injeksi',
              'Injeksi Vitamin',
              'Perawatan Kateter',
              'Perawatan NGT',
              'Perawatan Kolostomi',
              'Perawatan Lansia (Harian)',
              'Sunat'
            ]
          )
        )
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.area is string
        && request.resource.data.area.size() > 0
        && request.resource.data.notes is string
        && request.resource.data.updatedAt == request.time
      )
      // Pembatalan oleh pemilik hanya mengubah status dan updatedAt.
      || (
        isCompletePatient()
        && resource.data.patientUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time
      )
      // Hanya admin yang boleh menerima dan menugaskan praktisi terverifikasi.
      || (
        isAdmin()
        && resource.data.status == 'pending'
        && resource.data.nurseUid == null
        && resource.data.nurseName == null
        && resource.data.nursePhone == null
        && request.resource.data.status == 'accepted'
        && isVerifiedPractitioner(request.resource.data.nurseUid)
        && request.resource.data.nurseName is string
        && request.resource.data.nurseName.size() > 0
        && request.resource.data.nursePhone is string
        && request.resource.data.nursePhone.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nurseUid', 'nurseName', 'nursePhone', 'status', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
      )
      // Admin boleh menolak pesanan pending tanpa menugaskan praktisi.
      || (
        isAdmin()
        && resource.data.status == 'pending'
        && resource.data.nurseUid == null
        && resource.data.nurseName == null
        && resource.data.nursePhone == null
        && request.resource.data.status == 'rejected'
        && request.resource.data.nurseUid == null
        && request.resource.data.nurseName == null
        && request.resource.data.nursePhone == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
      )
      // Praktisi terverifikasi yang ditugaskan dapat memulai layanan.
      || (
        signedIn()
        && isVerifiedPractitioner(request.auth.uid)
        && resource.data.nurseUid == request.auth.uid
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'in_progress'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
      )
      // Praktisi terverifikasi yang sama dapat menandai layanan selesai.
      || (
        signedIn()
        && isVerifiedPractitioner(request.auth.uid)
        && resource.data.nurseUid == request.auth.uid
        && resource.data.status == 'in_progress'
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
        && request.resource.data.completedAt == request.time
        && request.resource.data.updatedAt == request.time
      );

      allow delete: if false;
    }

    // Tanda baca pesan hanya dapat dikelola oleh peserta chat untuk akun mereka sendiri.
    match /bookingChats/{bookingId}/reads/{userId} {
      allow get: if signedIn() && request.auth.uid == userId
        && isChatParticipant(bookingId) && isChatReadable(bookingId);
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == userId
        && isChatParticipant(bookingId) && isChatReadable(bookingId)
        && request.resource.data.keys().hasOnly(['lastReadAt'])
        && request.resource.data.keys().hasAll(['lastReadAt'])
        && request.resource.data.lastReadAt is timestamp
        && request.resource.data.lastReadAt <= request.time;
      allow delete: if false;
    }

    // Percakapan memakai ID pesanan. Riwayat dan tindak lanjut chat tetap tersedia setelah layanan selesai; pesanan baru tetap dibuat terpisah.
    match /bookingChats/{bookingId}/messages/{messageId} {
      allow get, list: if isChatParticipant(bookingId) && isChatReadable(bookingId);
      allow create: if isChatParticipant(bookingId)
        && isChatOpen(bookingId)
        && request.resource.data.keys().hasAll(['senderUid', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  
    // Profil publik berisi informasi profesional saja; kontak, alamat rumah, dan STR tetap privat.
    match /practitionerPublicProfiles/{practitionerUid} {
      allow get: if isAdmin()
        || isCompletePatient()
        || (signedIn() && request.auth.uid == practitionerUid
          && isVerifiedPractitioner(practitionerUid));
      allow list: if false;

      function validPublicProfile() {
        return request.resource.data.keys().hasAll([
          'ownerUid', 'name', 'experienceYears', 'specialization',
          'bio', 'serviceArea', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'experienceYears', 'specialization',
          'bio', 'serviceArea', 'updatedAt'
        ])
        && request.resource.data.ownerUid == practitionerUid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.experienceYears is int
        && request.resource.data.experienceYears >= 0
        && request.resource.data.experienceYears <= 80
        && request.resource.data.specialization is string
        && request.resource.data.specialization.size() <= 200
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 1000
        && request.resource.data.serviceArea is string
        && request.resource.data.serviceArea.size() <= 200
        && request.resource.data.updatedAt == request.time;
      }

      allow create, update: if signedIn()
        && request.auth.uid == practitionerUid
        && isVerifiedPractitioner(practitionerUid)
        && validPublicProfile();
      allow delete: if false;
    }

  }
}
